    SECURITY__AUDIT_LOGIN {
        UUID id PK
        UUID user_id FK
    }

    SECURITY__EMAIL_VERIFICATION {
        UUID id PK
        UUID user_id FK
    }

    SECURITY__FEATURE {
        UUID id PK
        UUID module_id FK
    }

    SECURITY__MODULE {
        UUID id PK
    }

    SECURITY__PASSWORD_RESET_REQUEST {
        UUID id PK
        UUID user_id FK
    }

    SECURITY__REFRESH_TOKEN {
        UUID id PK
        UUID replaced_by FK
        UUID user_id FK
    }

    SECURITY__ROLE {
        UUID id PK
    }

    SECURITY__ROLE_FEATURE {
        UUID id PK
        UUID feature_id FK
        UUID role_id FK
    }

    SECURITY__USER {
        UUID id PK
    }

    SECURITY__USER_ROLE {
        UUID id PK
        UUID role_id FK
        UUID user_id FK
    }

    SECURITY__USER_STATUS_AUDIT {
        INT8 id PK
        UUID user_id FK
    }

    SECURITY__USER o|--o{ SECURITY__AUDIT_LOGIN : user_id

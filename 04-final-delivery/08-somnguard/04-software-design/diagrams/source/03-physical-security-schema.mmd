    SECURITY__ROLE ||--o{ SECURITY__USER_ROLE : role_id
    SECURITY__USER ||--o{ SECURITY__USER_ROLE : user_id
    SECURITY__USER ||--o{ SECURITY__USER_STATUS_AUDIT : user_id
